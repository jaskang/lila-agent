{
  "name": "lila",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build:protocol": "pnpm --filter @lila/protocol build",
    "build": "pnpm build:protocol && pnpm --filter @lila/desktop build",
    "dev": "pnpm build:protocol && pnpm --parallel --filter @lila/core --filter @lila/desktop dev",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm build:protocol && pnpm -r typecheck",
    "test": "pnpm build:protocol && vitest run"
  },
  "devDependencies": {
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
