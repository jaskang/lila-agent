{
  "name": "lila",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --parallel --filter '@lila/server' --filter '@lila/web' dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "lint": "oxlint",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2"
  }
}
